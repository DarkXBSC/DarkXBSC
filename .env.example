# Dark 全新项目 · 仅保存在本机
# 浏览网站及用户钱包操作无需部署私钥；部署或启用部署钱包代补结算 Gas 时填写。
# 私钥/API 密钥不要发到聊天、截图、前端或公开仓库。

# 1. 部署账户：填写 0x 开头的 64 位十六进制私钥，不是助记词。
DEPLOYER_PRIVATE_KEY=

# 2. 合约角色：填写公开钱包地址；允许明确填写同一个地址。
# 留空表示尚未确定，不自动把部署者当作所有角色。
CONTRACT_OWNER=
FEE_RECIPIENT=

# 3. 网络：已按官方文档填写公共 RPC，也可以换成自己的节点。
BSC_CHAIN_ID=56
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
ROBINHOOD_CHAIN_ID=4663
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# 4. 新合约部署的每条链累计费用上限（原生币），不是转账或首买金额。
# 当前 BSC 已部署；此处保留空值，避免复制模板后误广播。空值不代表无限预算。
MAX_DEPLOY_COST_BSC=
MAX_DEPLOY_COST_ROBINHOOD=

# 5. 合约源码验证。API key 仅供本地部署/验证脚本使用。
# BSC 的 Etherscan V2 验证凭据；可稍后补填。
ETHERSCAN_API_KEY=
ROBINHOOD_VERIFIER_URL=https://robinhoodchain.blockscout.com/api/
# Robinhood Blockscout 验证不预设需要 API key；如服务要求再填。
ROBINHOOD_EXPLORER_API_KEY=

# 图片使用已接入的 Flap 上传服务，不需要 Pinata JWT。
# 当前地址与验证状态在 public/deployments.json；不要为测试重复部署。

# Server-side BSC discovery and candlesticks
GMGN_API_KEY=
# Optional automatic Binance UID payments. Use a funded Binance Pay merchant account.
BINANCE_PAY_KEY=
BINANCE_PAY_SECRET=
# Dedicated public HD branch controlled by the merchant, e.g. m/44'/60'/0'/0 xpub. Never enter an xprv.
GIVING_COLLECTION_XPUB=
# Local 32-byte random hex encryption key. Back up with the private settlement ledger.
GIVING_STORE_KEY=
# Maximum USDT per transfer. At least 1. Binance merchant fees are paid separately.
GIVING_PAYOUT_MAX_USDT=

# Private X Money rail, disabled until explicitly enabled. Generate a new dedicated seed
# with openssl rand -hex 32. Back it up offline with deployments/private/x-tax/.
# Keep the route seed separate from the deployer key.
X_TAX_HOSTED=no
X_TAX_ENABLE=no
# Set to deployer to let the local worker fund only eligible route wallets.
X_TAX_GAS_SPONSOR=off
# Native currency per funding operation including estimated sponsor transaction fees.
X_TAX_GAS_LIMIT_BNB=0.0001
X_TAX_GAS_LIMIT_ETH=0.0001
X_TAX_SEED=
X_API_BEARER_TOKEN=
RELAY_API_KEY=
X_TAX_MIN_USDT=25
X_TAX_MAX_USDT=
# X tax scanner requires finalized blocks and eth_getLogs
X_TAX_BSC_RPC_URL=https://bsc-rpc.publicnode.com
BASE_RPC_URL=https://mainnet.base.org

# Public X identity and signed cross-chain quotes, no API keys required
X_TAX_IDENTITY_API=https://api.fxtwitter.com
X_TAX_BRIDGE_API=https://1click.chaindefuser.com
