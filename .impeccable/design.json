  "narrative": {
    "northStar": "A clear desk for value in motion",
    "overview": "Dark opens with its original monochrome particle film. The desktop workspace then uses Bags’ welcome, trade, launch and earnings layouts for four distinct tasks. The geometric D identifies Dark in both the film and the sticky header.\n\nHome shows the configured X giving batch and the verified BSC contract count. Trade compares Flap markets by stage. Launch collects a token’s public details, beneficiary and economics in reading order. Giving starts with a choice to track a payout or select a tax beneficiary.",
    "keyCharacteristics": [
      "Centered navigation with five page links and a More tools button in a black or paper-colored header. Wallet and search controls sit to its right.",
      "A fine scanline texture frames solid cards with thin, low-contrast edges.",
      "The Trade view is wide and dense. Launch and Giving use centered single columns.",
      "Open Runde handles interface text. Archivo Black sets the home, market and giving display headings."
    ],
    "rules": [
      {
        "name": "The Theme Pair Rule",
        "body": "Invert the geometric D on dark chrome and preserve the original colors of token art across themes.",
        "section": "colors"
      },
      {
        "name": "The Price Precision Rule",
        "body": "Keep enough leading zeros to read a small price. Show the time interval and currency beside its chart.",
        "section": "typography"
      }
    ],
    "dos": [
      "Keep the notice about Dark’s official token visible on Home.",
      "Identify each market source and the time interval for each chart.",
      "Keep the wallet-signing action after review, and label beneficiary checks beside their controls.",
      "Preserve keyboard focus, reduced motion, first-entry skip and About replay."
    ],
    "donts": [
      "Add mobile layouts or touch-specific controls.",
      "Use northeast-arrow decorations on links, buttons or signage.",
      "Substitute projected earnings, mock trades or unverified payments for measured values."
    ]
  }
}
