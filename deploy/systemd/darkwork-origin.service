[Unit]
Description=Darkwork TLS origin
After=network.target

[Service]
User=darkwork-origin
Group=darkwork-origin
WorkingDirectory=/opt/darkwork/current
ExecStart=/usr/local/bin/node24 scripts/public-origin.mjs
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
