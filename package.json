{
  "name": "dark-genesis",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "x:convert": "node scripts/x-convert.mjs",
    "dev": "vite --host 127.0.0.1 --port 5206 --strictPort",
    "prebuild": "python3 scripts/package.py",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5206 --strictPort",
    "contracts:compile": "node scripts/compile.mjs",
    "test": "node scripts/compile.mjs --test && node scripts/compile-pay.mjs && node --test --test-concurrency=1 test/*.test.mjs",
    "preflight": "node scripts/preflight.mjs",
    "deploy:plan": "node scripts/deploy.mjs",
    "deploy:execute": "node scripts/deploy.mjs --broadcast",
    "verify": "node scripts/verify.mjs",
    "server": "node scripts/server.mjs",
    "start": "node scripts/start.mjs",
    "pay:compile": "node scripts/compile-pay.mjs",
    "test:pay": "npm run pay:compile && node --test --test-concurrency=1 test/agent-pay.test.mjs test/pay-vault.test.mjs"
  },
  "dependencies": {
    "@defuse-protocol/one-click-sdk-typescript": "0.1.26",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@noble/ed25519": "1.7.5",
    "@railgun-community/engine": "9.9.1",
    "@zkp2p/cash": "0.8.2",
    "dotenv": "17.2.3",
    "ethers": "6.17.0",
    "gmgn-cli": "1.7.1",
    "gsap": "3.15.1",
    "lightweight-charts": "5.3.0",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.18.6",
    "three": "0.187.0",
    "viem": "2.57.10"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.0.2",
    "@openzeppelin/contracts-upgradeable": "^4.9.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "5.1.0",
    "assert": "2.1.0",
    "buffer": "6.0.3",
    "events": "3.3.0",
    "ganache": "7.9.2",
    "prettier": "3.6.2",
    "process": "0.11.10",
    "solc": "0.8.30",
    "stream-browserify": "3.0.0",
    "typescript": "5.9.3",
    "vite": "7.2.0"
  },
  "engines": {
    "node": ">=24"
  }
}
